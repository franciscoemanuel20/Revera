{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/verify-deploy-seguro.mjs && npm run build",
  "crons": [
    {
      "path": "/api/cron/carrinho-abandonado",
      "schedule": "*/20 * * * *"
    },
    {
      "path": "/api/cron/conversoes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/paypal-conciliacao",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/confirmacao-cliente",
      "schedule": "*/30 * * * *"
    }
  ]
}
