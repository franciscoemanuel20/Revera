# =============================================================================
# Reverá — variáveis de ambiente (SOMENTE NOMES; nunca commitar valores)
# Sem projeto Supabase real ainda — ver README, "decisões pendentes".
# =============================================================================

# --- Supabase (projeto ainda não existe; criar exige autorização do Francisco) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagamento ---
# 'mock' é o único provider implementado neste scaffold (src/lib/payments).
# 'infinitepay' existe só como valor válido da env — o adapter real lança
# erro de propósito até o gateway ser decidido e implementado.
PAYMENT_PROVIDER=mock
# INFINITEPAY_API_KEY=            # preencher quando decidido

# --- Frete ---
# A presença do TOKEN é o que troca o mock pela SuperFrete de verdade — não
# há uma variável "SHIPPING_PROVIDER" separada. Consequência a ter em mente:
# no instante em que o token entrar na Vercel, o frete real passa a valer,
# sem deploy. Por isso ele é a ÚLTIMA coisa a configurar.
#
# O token é POR CONTA, e a conta é a mesma carteira de onde saem as etiquetas.
# Pode ser o mesmo do site irmão (mesma operação, mesmo endereço de origem);
# nesse caso as etiquetas das duas marcas aparecem juntas no painel deles e
# consomem o mesmo saldo.
SUPERFRETE_TOKEN=
# "1" usa https://sandbox.superfrete.com; qualquer outro valor usa produção.
SUPERFRETE_SANDBOX=

# Identificação exigida pela SuperFrete em toda requisição (eles recusam sem
# ela). O padrão no código já identifica a Reverá — só preencha para mudar.
SUPERFRETE_USER_AGENT=

# --- De onde a peça sai ---
# Todos têm padrão no código (Rua Síria 71, sala 39 — São José dos Campos/SP,
# CEP 12216-530, conferido na base dos Correios em 19/08/2026). Endereço
# comercial não é segredo, e assim a cotação funciona sem configuração
# nenhuma. Preencha só para mudar de endereço — o que não exige deploy.
SUPERFRETE_CEP_ORIGEM=
SUPERFRETE_REMETENTE_NOME=
SUPERFRETE_REMETENTE_RUA=
SUPERFRETE_REMETENTE_NUMERO=
SUPERFRETE_REMETENTE_COMPLEMENTO=
SUPERFRETE_REMETENTE_BAIRRO=
SUPERFRETE_REMETENTE_CIDADE=
SUPERFRETE_REMETENTE_UF=

# --- A caixa ---
# Padrão: 300 g em 30 × 20 × 5 cm, por peça. Erra para cima de propósito —
# ver o comentário em src/lib/shipping/regras.ts. Medir a embalagem real e
# preencher aqui é a única coisa que falta para o frete parar de ser
# aproximado.
SUPERFRETE_CAIXA_PESO_GRAMAS=
SUPERFRETE_CAIXA_COMPRIMENTO_CM=
SUPERFRETE_CAIXA_LARGURA_CM=
SUPERFRETE_CAIXA_ALTURA_CM=

# --- Rastreamento (não implementado neste scaffold — fora de escopo) ---
META_PIXEL_ID=
META_CAPI_TOKEN=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# --- WhatsApp pós-compra ---
# 12981409901 — usar SOMENTE em componentes pós-compra, nunca em página
# pré-compra ou metadata (ver docs internos do projeto sobre contato único).
# WHATSAPP_POST_PURCHASE_NUMBER=

# Segredo do caminho do webhook de pagamento.
# Gere com: openssl rand -base64 32
# Sem ela o pagamento NÃO abre (proposital: no projeto irmão a ausência
# saiu calada e nenhuma venda se confirmou por dias).
PAYMENT_WEBHOOK_SECRET=

# InfiniteTag da conta InfinitePay, SEM o "$". Só necessária quando
# PAYMENT_PROVIDER=infinitepay.
INFINITEPAY_HANDLE=

# URL pública do site, usada para montar webhook e redirect do gateway.
NEXT_PUBLIC_SITE_URL=
